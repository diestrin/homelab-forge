[Unit]
Description=homelab-forge Slack intake (ADR-011 thin Socket Mode client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/media/diestrin/data/Projects/homelab-forge
Environment=FORGE_REPO_ROOT=/media/diestrin/data/Projects/homelab-forge
Environment=FORGE_DATA_ROOT=/media/diestrin/data/forge
Environment=FORGE_SECRETS_ROOT=/media/diestrin/data/secrets
Environment=VAULT_ADDR=http://127.0.0.1:8200
Environment=PATH=/media/diestrin/data/forge/factory/venv/bin:/home/diestrin/.nix-profile/bin:/home/diestrin/.local/bin:/usr/local/bin:/usr/bin:/bin
# FORGE_API_TOKEN from Vault secret/forge/control-plane (same file as the worker).
# Slack tokens + allowlist in slack-orchestrator.env — do not duplicate the API token there.
EnvironmentFile=-/media/diestrin/data/secrets/forge/control-plane.env
EnvironmentFile=-/media/diestrin/data/secrets/forge/slack-orchestrator.env
Environment=FORGE_CONTROL_PLANE_URL=https://localpower.diegobarahona.com
ExecStart=/media/diestrin/data/forge/factory/venv/bin/python /media/diestrin/data/Projects/homelab-forge/factory/orchestrator/slack_intake.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
