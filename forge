#!/usr/bin/env bash
# homelab-forge operator CLI (Phase 2+).
# Usage:
#   ./forge sandbox enter <project> --profile <name> [-- command...]
#   ./forge sandbox list
#   ./forge sandbox init
#   ./forge sandbox smoke
#   ./forge factory ...
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=sandbox/lib/common.sh
source "$REPO_ROOT/sandbox/lib/common.sh"

PROFILES=(trusted devcontainer incus k8s-workload agent-cell)
TASK_LIB="$REPO_ROOT/factory/scripts/task_lib.py"

usage() {
  cat <<'EOF'
forge — homelab-forge operator CLI

Usage:
  forge sandbox enter <project> --profile <profile> [-- <command>...]
  forge sandbox list
  forge sandbox init
  forge sandbox smoke
  forge factory validate|list|get|claim|set-status|sync|run|worker|demo|github-token|help
  forge help

Profiles (ADR-002):
  trusted        L0 host workspace (flake/direnv)
  devcontainer   L1 rootless Docker, project bind only
  incus          L2 Incus system container (requires Incus)
  k8s-workload   L3 k3s apply/enter (forge-agents by default)
  agent-cell     L4 ephemeral cell, no docker.sock, project-only mount

Factory (ADR-004):
  factory validate              validate factory/tasks/*.yaml
  factory list                  list tasks
  factory get TASK-NNN          print task YAML
  factory claim [--task ID]     claim next (or specific) proposed task
  factory set-status ID STATUS  transition status
  factory sync                  mirror git statuses → GitHub Projects
  factory github-token          mint GitHub App installation token via Vault
  factory run TASK-NNN          run worker once for a task
  factory worker [--once]       long-running poll loop (or single iteration)
  factory demo                  guided portfolio demo script

Env:
  FORGE_DATA_ROOT       default /media/diestrin/data/forge
  FORGE_PROJECTS_ROOT   default /media/diestrin/data/Projects
  FORGE_PUBLISH_PORT    host[:container] bound to 127.0.0.1 only
  FORGE_MEM / FORGE_CPUS / FORGE_PIDS   resource limit overrides
  FORGE_AGENT_RW        true|false (agent-cell project mount writable)
  FORGE_K8S_NAMESPACE   override for k8s-workload (default forge-agents)
  FORGE_WORKER_ID       worker assignee id
  FORGE_WORKER_POLL_SECONDS  daemon poll interval (default 30)
  FORGE_SKIP_VAULT      1 to skip AppRole login in workers
  KUBECONFIG            default ~/.kube/config
EOF
}

sandbox_list() {
  echo "Profiles:"
  for p in "${PROFILES[@]}"; do
    printf '  %-14s' "$p"
    case "$p" in
      trusted) echo "L0 host + flake/direnv" ;;
      devcontainer) echo "L1 rootless Docker" ;;
      incus)
        if command -v incus >/dev/null 2>&1; then
          echo "L2 Incus (installed)"
        else
          echo "L2 Incus (not installed — ./sandbox/scripts/install-incus.sh)"
        fi
        ;;
      k8s-workload)
        if [[ -f "${KUBECONFIG:-$HOME/.kube/config}" ]] && command -v kubectl >/dev/null 2>&1 && \
          kubectl cluster-info >/dev/null 2>&1; then
          echo "L3 k3s workload (cluster reachable)"
        else
          echo "L3 k3s (cluster not reachable — install via k8s/bootstrap/)"
        fi
        ;;
      agent-cell) echo "L4 ephemeral agent cell" ;;
    esac
  done
  echo
  echo "Projects root: $FORGE_PROJECTS_ROOT"
  echo "Forge state:   $FORGE_DATA_ROOT"
  echo "Secrets:       $FORGE_SECRETS_ROOT (never in git)"
}

sandbox_init() {
  forge_ensure_layout
  forge_info "Layout ready under $FORGE_DATA_ROOT"
  ls -la "$FORGE_DATA_ROOT"
}

sandbox_enter() {
  local project_arg="" profile="" 
  local -a rest=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile|-p)
        [[ $# -ge 2 ]] || forge_die "--profile requires a value"
        profile="$2"
        shift 2
        ;;
      --)
        shift
        rest+=("$@")
        break
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        forge_die "unknown option: $1"
        ;;
      *)
        if [[ -z "$project_arg" ]]; then
          project_arg="$1"
          shift
        else
          # Allow: forge sandbox enter proj --profile x command...
          rest+=("$@")
          break
        fi
        ;;
    esac
  done

  # Also support: enter <project> --profile x  with profile after project
  # Re-parse if profile still empty and rest contains --profile
  if [[ -z "$profile" ]]; then
    local -a filtered=()
    local i=0
    while [[ $i -lt ${#rest[@]} ]]; do
      if [[ "${rest[$i]}" == "--profile" || "${rest[$i]}" == "-p" ]]; then
        profile="${rest[$((i + 1))]:-}"
        i=$((i + 2))
        continue
      fi
      filtered+=("${rest[$i]}")
      i=$((i + 1))
    done
    rest=("${filtered[@]}")
  fi

  [[ -n "$project_arg" ]] || forge_die "usage: forge sandbox enter <project> --profile <name>"
  [[ -n "$profile" ]] || forge_die "usage: forge sandbox enter <project> --profile <name>"

  local valid=0
  for p in "${PROFILES[@]}"; do
    [[ "$p" == "$profile" ]] && valid=1 && break
  done
  [[ "$valid" -eq 1 ]] || forge_die "unknown profile '$profile' (see: forge sandbox list)"

  local project
  project="$(forge_resolve_project "$project_arg")"
  export FORGE_PROFILE="$profile"

  # shellcheck source=/dev/null
  source "$REPO_ROOT/sandbox/profiles/${profile}.sh"
  profile_enter "$project" "${rest[@]}"
}

cmd_sandbox() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    enter) sandbox_enter "$@" ;;
    list) sandbox_list ;;
    init) sandbox_init ;;
    smoke)
      "$REPO_ROOT/sandbox/scripts/smoke-test.sh" "$@"
      ;;
    ""|-h|--help) usage; exit 0 ;;
    *) forge_die "unknown sandbox subcommand: $sub" ;;
  esac
}

factory_usage() {
  cat <<'EOF'
forge factory — task board + worker (ADR-010 control plane)

  validate                      validate optional git mirror YAML
  list | get | claim | set-status | approve | next-id
                                (via control plane API when FORGE_* env set)
  migrate-yaml [--dry-run]      one-time YAML → Postgres
  export-yaml                   optional git mirror export from API
  sync [--dry-run]
  github-token
  run <TASK-NNN>
  worker [--once]
  orchestrator                  Slack Socket Mode (/forge slash)
  demo
EOF
}

cmd_factory() {
  local sub="${1:-}"
  shift || true
  forge_require_cmd python3
  case "$sub" in
    validate)
      python3 "$TASK_LIB" --repo "$REPO_ROOT" validate
      ;;
    list)
      if [[ -n "${FORGE_CONTROL_PLANE_URL:-}" && -n "${FORGE_API_TOKEN:-}" ]]; then
        python3 -c "import sys; sys.path.insert(0,'$REPO_ROOT/factory/scripts'); import control_plane_client as cp; [print(f\"{t['id']}\t{t['status']}\t{t['title']}\") for t in cp.list_tasks()]"
      else
        python3 "$TASK_LIB" --repo "$REPO_ROOT" list
      fi
      ;;
    get)
      [[ $# -ge 1 ]] || forge_die "usage: forge factory get TASK-NNN"
      if [[ -n "${FORGE_CONTROL_PLANE_URL:-}" && -n "${FORGE_API_TOKEN:-}" ]]; then
        python3 -c "import sys,json; sys.path.insert(0,'$REPO_ROOT/factory/scripts'); import control_plane_client as cp; print(json.dumps(cp.get_task('$1'), indent=2))"
      else
        python3 "$TASK_LIB" --repo "$REPO_ROOT" get "$1"
      fi
      ;;
    claim)
      local task="" worker="${FORGE_WORKER_ID:-worker-$(hostname)}"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --task) task="$2"; shift 2 ;;
          --worker) worker="$2"; shift 2 ;;
          *) forge_die "unknown claim option: $1" ;;
        esac
      done
      if [[ -n "${FORGE_CONTROL_PLANE_URL:-}" && -n "${FORGE_API_TOKEN:-}" ]]; then
        FORGE_WORKER_ID="$worker" FORGE_CLAIM_TASK="$task" python3 - <<PY
import os, sys
sys.path.insert(0, "$REPO_ROOT/factory/scripts")
import control_plane_client as cp
tid = os.environ.get("FORGE_CLAIM_TASK") or None
t = cp.claim(os.environ["FORGE_WORKER_ID"], tid, via_queue=True)
print(t["id"] if t else "")
PY
      elif [[ -n "$task" ]]; then
        python3 "$TASK_LIB" --repo "$REPO_ROOT" claim --task "$task" --worker "$worker"
      else
        python3 "$TASK_LIB" --repo "$REPO_ROOT" claim --worker "$worker"
      fi
      ;;
    set-status)
      [[ $# -ge 2 ]] || forge_die "usage: forge factory set-status TASK-NNN STATUS"
      if [[ -n "${FORGE_CONTROL_PLANE_URL:-}" && -n "${FORGE_API_TOKEN:-}" ]]; then
        FORGE_STATUS_TASK="$1" FORGE_STATUS_VAL="$2" python3 - <<PY
import os, sys
sys.path.insert(0, "$REPO_ROOT/factory/scripts")
import control_plane_client as cp
assignee = os.environ.get("FORGE_WORKER_ID") or None
cp.set_status(os.environ["FORGE_STATUS_TASK"], os.environ["FORGE_STATUS_VAL"], assignee)
print(f"{os.environ['FORGE_STATUS_TASK']} → {os.environ['FORGE_STATUS_VAL']}")
PY
      elif [[ -n "${FORGE_WORKER_ID:-}" ]]; then
        python3 "$TASK_LIB" --repo "$REPO_ROOT" set-status "$1" "$2" --assignee "$FORGE_WORKER_ID"
      else
        python3 "$TASK_LIB" --repo "$REPO_ROOT" set-status "$1" "$2"
      fi
      ;;
    approve)
      [[ $# -ge 1 ]] || forge_die "usage: forge factory approve TASK-NNN"
      if [[ -n "${FORGE_CONTROL_PLANE_URL:-}" && -n "${FORGE_API_TOKEN:-}" ]]; then
        python3 -c "import sys; sys.path.insert(0,'$REPO_ROOT/factory/scripts'); import control_plane_client as cp; cp.approve('$1'); print('$1 → proposed')"
      else
        python3 "$TASK_LIB" --repo "$REPO_ROOT" approve "$1"
      fi
      ;;
    next-id)
      if [[ -n "${FORGE_CONTROL_PLANE_URL:-}" && -n "${FORGE_API_TOKEN:-}" ]]; then
        python3 -c "import sys; sys.path.insert(0,'$REPO_ROOT/factory/scripts'); import control_plane_client as cp; print(cp.next_task_id())"
      else
        python3 "$TASK_LIB" --repo "$REPO_ROOT" next-id
      fi
      ;;
    migrate-yaml)
      python3 "$REPO_ROOT/factory/scripts/migrate-yaml-to-db.py" --repo "$REPO_ROOT" "$@"
      ;;
    export-yaml)
      python3 "$REPO_ROOT/factory/scripts/export-yaml-from-db.py" --repo "$REPO_ROOT" "$@"
      ;;
    sync)
      "$REPO_ROOT/factory/scripts/sync-projects.sh" "$@"
      ;;
    github-token)
      # Mint / print installation token (requires Vault AppRole + App credentials)
      if [[ -z "${VAULT_TOKEN:-}" ]]; then
        VAULT_TOKEN_VAL="$("$REPO_ROOT/factory/scripts/vault-agent-login.sh" --print-token)"
        export VAULT_TOKEN="$VAULT_TOKEN_VAL"
        export VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
      fi
      "$REPO_ROOT/factory/scripts/github-app-token.sh"
      ;;
    run)
      [[ $# -ge 1 ]] || forge_die "usage: forge factory run TASK-NNN"
      "$REPO_ROOT/factory/worker/run-task.sh" "$1"
      ;;
    worker)
      "$REPO_ROOT/factory/worker/daemon.sh" "$@"
      ;;
    orchestrator)
      exec python3 "$REPO_ROOT/factory/orchestrator/slack_intake.py" "$@"
      ;;
    demo)
      "$REPO_ROOT/factory/demo/run-demo.sh" "$@"
      ;;
    ""|-h|--help) factory_usage ;;
    *) forge_die "unknown factory subcommand: $sub (try: forge factory help)" ;;
  esac
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    sandbox) cmd_sandbox "$@" ;;
    factory) cmd_factory "$@" ;;
    help|-h|--help) usage ;;
    *)
      forge_die "unknown command: $cmd (try: forge help)"
      ;;
  esac
}

main "$@"
