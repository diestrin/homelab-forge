apiVersion: apps/v1
kind: Deployment
metadata:
  name: forge-site
  namespace: forge-preview-${PREVIEW_PR_NUMBER}
  labels:
    app: forge-site
    forge.homelab/preview: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: forge-site
  template:
    metadata:
      labels:
        app: forge-site
        forge.homelab/preview: "true"
    spec:
      initContainers:
        - name: wait-postgres
          image: postgres:16-alpine
          envFrom:
            - secretRef:
                name: forge-site-secrets
          command:
            - sh
            - -c
            - |
              until psql "$DATABASE_URL" -c 'SELECT 1' >/dev/null 2>&1; do
                echo "waiting for postgres..."
                sleep 2
              done
      containers:
        - name: forge-site
          image: ${PREVIEW_IMAGE}
          imagePullPolicy: Always
          ports:
            - containerPort: 3000
          envFrom:
            - secretRef:
                name: forge-site-secrets
          env:
            - name: FORGE_RUN_MIGRATIONS
              value: "true"
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          readinessProbe:
            httpGet:
              path: /api/v1/health
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/v1/health
              port: 3000
            initialDelaySeconds: 30
            periodSeconds: 20
