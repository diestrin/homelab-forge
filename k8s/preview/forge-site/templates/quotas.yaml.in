apiVersion: v1
kind: ResourceQuota
metadata:
  name: preview-quota
  namespace: forge-preview-${PREVIEW_PR_NUMBER}
spec:
  hard:
    requests.cpu: "1"
    requests.memory: 1Gi
    limits.cpu: "2"
    limits.memory: 2Gi
    pods: "4"
---
apiVersion: v1
kind: LimitRange
metadata:
  name: preview-limits
  namespace: forge-preview-${PREVIEW_PR_NUMBER}
spec:
  limits:
    - type: Container
      default:
        cpu: 250m
        memory: 256Mi
      defaultRequest:
        cpu: 50m
        memory: 64Mi
      max:
        cpu: "2"
        memory: 1Gi
